rules_version = '2';
// Generated from src/modules/catalog.js and scripts/generate-rules.mjs.
// Publish to the par-education Firestore database before using real records.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() {
      return signedIn() && profile().active == true
        && profile().role in ['admin', 'dept_head', 'profesor', 'lab_assistant', 'student', 'alumni'];
    }
    function role(r) { return active() && profile().role == r; }
    function admin() { return role('admin'); }
    function staff() { return active() && profile().role in ['admin', 'dept_head', 'profesor', 'lab_assistant']; }
    function own(d) { return active() && d.ownerUid == request.auth.uid; }
    function instructor(d) { return role('profesor') && d.instructorUid == request.auth.uid; }
    function inDepartment(d) {
      return role('dept_head') && profile().departmentId is string
        && profile().departmentId.size() > 0 && d.departmentId == profile().departmentId;
    }
    function created(d) {
      return d.createdAt == request.time && d.updatedAt == request.time && d.createdBy == request.auth.uid;
    }
    function restored(d) {
      return d.createdAt is timestamp && d.createdBy is string
        && d.createdBy.size() > 0 && d.createdBy.size() <= 1500
        && d.updatedAt == request.time;
    }
    function pendingSelf(uid, d) {
      return signedIn() && uid == request.auth.uid
        && d.role == 'student' && d.active == false && d.departmentId == ''
        && d.email == request.auth.token.email && created(d);
    }
    function updated(d) {
      return d.updatedAt == request.time && d.createdAt == resource.data.createdAt
        && d.createdBy == resource.data.createdBy;
    }
    function assignedCourse(d) {
      return get(/databases/$(database)/documents/courses/$(d.courseId)).data.instructorUid == request.auth.uid
        && d.instructorUid == request.auth.uid;
    }
    function enrolledStudent(d) {
      let enrollment = get(/databases/$(database)/documents/enrollments/$(d.courseId + '__' + d.ownerUid)).data;
      return enrollment.ownerUid == d.ownerUid && enrollment.courseId == d.courseId && enrollment.status == 'Odobreno';
    }
    function decision(d) {
      return resource.data.status == 'Na čekanju' && d.status in ['Odobreno', 'Odbijeno']
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) && updated(d);
    }
    function valid_students(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'jmbag', 'study', 'group', 'email', 'departmentId', 'year', 'status', 'homeUniversity', 'country', 'exchangeSemester', 'gpa', 'ects', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'departmentId', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (!('ownerUid' in d) || d.ownerUid == '' || (d.ownerUid is string && d.ownerUid.size() <= 200))
        && (d.name is string && d.name.size() <= 200 && d.name.size() > 0)
        && (!('jmbag' in d) || d.jmbag == '' || (d.jmbag is string && d.jmbag.size() <= 200))
        && (!('study' in d) || d.study == '' || (d.study is string && d.study.size() <= 200))
        && (!('group' in d) || d.group == '' || (d.group is string && d.group.size() <= 200))
        && (!('email' in d) || d.email == '' || (d.email is string && d.email.size() <= 200 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')))
        && (d.departmentId is string && d.departmentId.size() <= 200 && d.departmentId.size() > 0)
        && (!('year' in d) || (d.year is int && d.year >= 1 && d.year <= 6))
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Redovni', 'Izvanredni', 'Alumni', 'Erasmus'])
        && (!('homeUniversity' in d) || d.homeUniversity == '' || (d.homeUniversity is string && d.homeUniversity.size() <= 200))
        && (!('country' in d) || d.country == '' || (d.country is string && d.country.size() <= 200))
        && (!('exchangeSemester' in d) || d.exchangeSemester == '' || (d.exchangeSemester is string && d.exchangeSemester.size() <= 200))
        && (!('gpa' in d) || (d.gpa is number && d.gpa >= 1 && d.gpa <= 5))
        && (!('ects' in d) || (d.ects is number && d.ects >= 0 && d.ects <= 360));
    }
    function valid_employees(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'position', 'departmentName', 'departmentId', 'email', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'name', 'position', 'departmentId', 'email', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.name is string && d.name.size() <= 200 && d.name.size() > 0)
        && (d.position is string && d.position.size() <= 200 && d.position.size() > 0)
        && (!('departmentName' in d) || d.departmentName == '' || (d.departmentName is string && d.departmentName.size() <= 200))
        && (d.departmentId is string && d.departmentId.size() <= 200 && d.departmentId.size() > 0)
        && (d.email is string && d.email.size() <= 200 && d.email.size() > 0 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$'));
    }
    function valid_courses(d) {
      return d.keys().hasOnly(['title', 'courseType', 'ects', 'semester', 'instructorUid', 'instructorName', 'room', 'day', 'startTime', 'endTime', 'description', 'outcomes', 'literature', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'semester', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (!('courseType' in d) || d.courseType == '' || (d.courseType is string && d.courseType.size() <= 200))
        && (!('ects' in d) || (d.ects is number && d.ects >= 1 && d.ects <= 30))
        && (d.semester is string && d.semester.size() <= 200 && d.semester.size() > 0 && d.semester in ['Zimski', 'Ljetni'])
        && (!('instructorUid' in d) || d.instructorUid == '' || (d.instructorUid is string && d.instructorUid.size() <= 200))
        && (!('instructorName' in d) || d.instructorName == '' || (d.instructorName is string && d.instructorName.size() <= 200))
        && (!('room' in d) || d.room == '' || (d.room is string && d.room.size() <= 200))
        && (!('day' in d) || d.day == '' || (d.day is string && d.day.size() <= 200 && d.day in ['Pon', 'Uto', 'Sri', 'Čet', 'Pet']))
        && (!('startTime' in d) || (d.startTime is string && d.startTime.size() <= 200 && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('endTime' in d) || (d.endTime is string && d.endTime.size() <= 200 && d.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('description' in d) || d.description == '' || (d.description is string && d.description.size() <= 20000))
        && (!('outcomes' in d) || d.outcomes == '' || (d.outcomes is string && d.outcomes.size() <= 20000))
        && (!('literature' in d) || d.literature == '' || (d.literature is string && d.literature.size() <= 20000))
        && (!('startTime' in d) || !('endTime' in d) || d.endTime > d.startTime);
    }
    function valid_exams(d) {
      return d.keys().hasOnly(['courseId', 'instructorUid', 'instructorName', 'title', 'date', 'time', 'room', 'capacity', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['courseId', 'instructorUid', 'title', 'date', 'time', 'room', 'capacity', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.courseId is string && d.courseId.size() <= 200 && d.courseId.size() > 0)
        && (d.instructorUid is string && d.instructorUid.size() <= 200 && d.instructorUid.size() > 0)
        && (!('instructorName' in d) || d.instructorName == '' || (d.instructorName is string && d.instructorName.size() <= 200))
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.time is string && d.time.size() <= 200 && d.time.size() > 0 && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (d.room is string && d.room.size() <= 200 && d.room.size() > 0)
        && (d.capacity is int && d.capacity >= 1 && d.capacity <= 1000);
    }
    function valid_grades(d) {
      return d.keys().hasOnly(['ownerUid', 'studentName', 'courseId', 'courseTitle', 'instructorUid', 'grade', 'date', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'studentName', 'courseId', 'courseTitle', 'instructorUid', 'grade', 'date', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.studentName is string && d.studentName.size() <= 200 && d.studentName.size() > 0)
        && (d.courseId is string && d.courseId.size() <= 200 && d.courseId.size() > 0)
        && (d.courseTitle is string && d.courseTitle.size() <= 200 && d.courseTitle.size() > 0)
        && (d.instructorUid is string && d.instructorUid.size() <= 200 && d.instructorUid.size() > 0)
        && (d.grade is int && d.grade >= 1 && d.grade <= 5)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function valid_enrollments(d) {
      return d.keys().hasOnly(['ownerUid', 'studentId', 'ownerName', 'courseId', 'courseTitle', 'instructorUid', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerName', 'courseId', 'courseTitle', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (!('ownerUid' in d) || d.ownerUid == '' || (d.ownerUid is string && d.ownerUid.size() <= 200))
        && (!('studentId' in d) || d.studentId == '' || (d.studentId is string && d.studentId.size() <= 200))
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.courseId is string && d.courseId.size() <= 200 && d.courseId.size() > 0)
        && (d.courseTitle is string && d.courseTitle.size() <= 200 && d.courseTitle.size() > 0)
        && (!('instructorUid' in d) || d.instructorUid == '' || (d.instructorUid is string && d.instructorUid.size() <= 200))
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Na čekanju', 'Odobreno', 'Odbijeno'])
        && (('ownerUid' in d && d.ownerUid.size() > 0) || ('studentId' in d && d.studentId.size() > 0));
    }
    function valid_examBookings(d) {
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'examId', 'courseId', 'instructorUid', 'title', 'date', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'ownerName', 'examId', 'courseId', 'instructorUid', 'title', 'date', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.examId is string && d.examId.size() <= 200 && d.examId.size() > 0)
        && (d.courseId is string && d.courseId.size() <= 200 && d.courseId.size() > 0)
        && (d.instructorUid is string && d.instructorUid.size() <= 200 && d.instructorUid.size() > 0)
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Na čekanju', 'Odobreno', 'Odbijeno']);
    }
    function valid_calendarEvents(d) {
      return d.keys().hasOnly(['title', 'courseId', 'instructorUid', 'study', 'group', 'academicYear', 'semester', 'teachingType', 'seriesId', 'date', 'time', 'endTime', 'room', 'day', 'instructorName', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'date', 'time', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (!('courseId' in d) || d.courseId == '' || (d.courseId is string && d.courseId.size() <= 200))
        && (!('instructorUid' in d) || d.instructorUid == '' || (d.instructorUid is string && d.instructorUid.size() <= 200))
        && (!('study' in d) || d.study == '' || (d.study is string && d.study.size() <= 200))
        && (!('group' in d) || d.group == '' || (d.group is string && d.group.size() <= 200))
        && (!('academicYear' in d) || d.academicYear == '' || (d.academicYear is string && d.academicYear.size() <= 200))
        && (!('semester' in d) || d.semester == '' || (d.semester is string && d.semester.size() <= 200 && d.semester in ['Zimski', 'Ljetni']))
        && (!('teachingType' in d) || d.teachingType == '' || (d.teachingType is string && d.teachingType.size() <= 200))
        && (!('seriesId' in d) || d.seriesId == '' || (d.seriesId is string && d.seriesId.size() <= 200))
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.time is string && d.time.size() <= 200 && d.time.size() > 0 && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (!('endTime' in d) || (d.endTime is string && d.endTime.size() <= 200 && d.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('room' in d) || d.room == '' || (d.room is string && d.room.size() <= 200))
        && (!('day' in d) || d.day == '' || (d.day is string && d.day.size() <= 200))
        && (!('instructorName' in d) || d.instructorName == '' || (d.instructorName is string && d.instructorName.size() <= 200))
        && (!('description' in d) || d.description == '' || (d.description is string && d.description.size() <= 2000))
        && (!('endTime' in d) || d.endTime > d.time);
    }
    function valid_projects(d) {
      return d.keys().hasOnly(['title', 'fundingLine', 'duration', 'budget', 'startDate', 'endDate', 'partners', 'workPackages', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'fundingLine', 'budget', 'startDate', 'endDate', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.fundingLine is string && d.fundingLine.size() <= 200 && d.fundingLine.size() > 0)
        && (!('duration' in d) || d.duration == '' || (d.duration is string && d.duration.size() <= 200))
        && (d.budget is number && d.budget >= 0 && d.budget <= 1000000000)
        && (d.startDate is string && d.startDate.size() <= 200 && d.startDate.size() > 0 && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.endDate is string && d.endDate.size() <= 200 && d.endDate.size() > 0 && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('partners' in d) || d.partners == '' || (d.partners is string && d.partners.size() <= 2000))
        && (!('workPackages' in d) || d.workPackages == '' || (d.workPackages is string && d.workPackages.size() <= 2000))
        && (!('description' in d) || d.description == '' || (d.description is string && d.description.size() <= 2000))
        && d.endDate >= d.startDate;
    }
    function valid_research(d) {
      return d.keys().hasOnly(['ownerUid', 'title', 'authors', 'projectId', 'status', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'title', 'authors', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.authors is string && d.authors.size() <= 200 && d.authors.size() > 0)
        && (!('projectId' in d) || d.projectId == '' || (d.projectId is string && d.projectId.size() <= 200))
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['U pripremi', 'Recenzija', 'Objavljeno'])
        && (!('description' in d) || d.description == '' || (d.description is string && d.description.size() <= 2000));
    }
    function valid_labs(d) {
      return d.keys().hasOnly(['title', 'tag', 'category', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'tag', 'category', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.tag is string && d.tag.size() <= 200 && d.tag.size() > 0)
        && (d.category is string && d.category.size() <= 200 && d.category.size() > 0)
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Dostupno', 'Zaduženo', 'Servis']);
    }
    function valid_labBookings(d) {
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'labId', 'title', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'ownerName', 'labId', 'title', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.labId is string && d.labId.size() <= 200 && d.labId.size() > 0)
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Na čekanju', 'Odobreno', 'Odbijeno']);
    }
    function valid_documents(d) {
      return d.keys().hasOnly(['title', 'category', 'date', 'url', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'category', 'date', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.category is string && d.category.size() <= 200 && d.category.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('url' in d) || d.url == '' || (d.url is string && d.url.size() <= 2000 && d.url.matches('^https://.+$')))
        && (!('description' in d) || d.description == '' || (d.description is string && d.description.size() <= 2000));
    }
    function valid_requests(d) {
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'type', 'details', 'status', 'response', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'ownerName', 'type', 'details', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.type is string && d.type.size() <= 200 && d.type.size() > 0 && d.type in ['Prijepis ocjena', 'Potvrda o statusu studenta', 'Ostalo'])
        && (d.details is string && d.details.size() <= 2000 && d.details.size() > 0)
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Na čekanju', 'U obradi', 'Riješeno', 'Odbijeno'])
        && (!('response' in d) || d.response == '' || (d.response is string && d.response.size() <= 2000));
    }
    function valid_finances(d) {
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'title', 'amount', 'dueDate', 'status', 'paymentReference', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'ownerName', 'title', 'amount', 'dueDate', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.amount is number && d.amount >= 0 && d.amount <= 1000000)
        && (d.dueDate is string && d.dueDate.size() <= 200 && d.dueDate.size() > 0 && d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Dugovanje', 'Plaćeno'])
        && (!('paymentReference' in d) || d.paymentReference == '' || (d.paymentReference is string && d.paymentReference.size() <= 2000));
    }
    function valid_employeeSchedules(d) {
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'date', 'activity', 'startTime', 'endTime', 'departmentId', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'ownerName', 'date', 'activity', 'startTime', 'endTime', 'departmentId', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.activity is string && d.activity.size() <= 200 && d.activity.size() > 0 && d.activity in ['Ured', 'Nastava', 'Godišnji odmor', 'Bolovanje', 'Putni nalog', 'Slobodan dan'])
        && (d.startTime is string && d.startTime.size() <= 200 && d.startTime.size() > 0 && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (d.endTime is string && d.endTime.size() <= 200 && d.endTime.size() > 0 && d.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (d.departmentId is string && d.departmentId.size() <= 200 && d.departmentId.size() > 0)
        && (!('startTime' in d) || !('endTime' in d) || d.endTime > d.startTime);
    }
    function valid_workEntries(d) {
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'date', 'category', 'hours', 'projectId', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'ownerName', 'date', 'category', 'hours', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.category is string && d.category.size() <= 200 && d.category.size() > 0 && d.category in ['Administracija', 'Nastava', 'Rad na projektu', 'Znanstveni rad', 'Izvanredne aktivnosti'])
        && (d.hours is number && d.hours >= 0.25 && d.hours <= 24)
        && (!('projectId' in d) || d.projectId == '' || (d.projectId is string && d.projectId.size() <= 200))
        && (d.description is string && d.description.size() <= 2000 && d.description.size() > 0);
    }
    function valid_vacations(d) {
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'startDate', 'endDate', 'days', 'status', 'details', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'ownerName', 'startDate', 'endDate', 'days', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.startDate is string && d.startDate.size() <= 200 && d.startDate.size() > 0 && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.endDate is string && d.endDate.size() <= 200 && d.endDate.size() > 0 && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.days is int && d.days >= 1 && d.days <= 60)
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Na čekanju', 'Odobreno', 'Odbijeno'])
        && (!('details' in d) || d.details == '' || (d.details is string && d.details.size() <= 2000))
        && d.endDate >= d.startDate;
    }
    function valid_alumniEvents(d) {
      return d.keys().hasOnly(['title', 'date', 'location', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'date', 'location', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.location is string && d.location.size() <= 200 && d.location.size() > 0)
        && (!('description' in d) || d.description == '' || (d.description is string && d.description.size() <= 2000));
    }
    function valid_evaluations(d) {
      return d.keys().hasOnly(['ownerUid', 'subject', 'rating', 'answers', 'comments', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'subject', 'rating', 'answers', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.subject is string && d.subject.size() <= 200 && d.subject.size() > 0)
        && (d.rating is int && d.rating >= 1 && d.rating <= 5)
        && (d.answers is string && d.answers.size() <= 2000 && d.answers.size() > 0)
        && (!('comments' in d) || d.comments == '' || (d.comments is string && d.comments.size() <= 2000));
    }
    function valid_notifications(d) {
      return d.keys().hasOnly(['ownerUid', 'title', 'message', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'title', 'message', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.message is string && d.message.size() <= 2000 && d.message.size() > 0);
    }
    function valid_users(d) {
      return d.keys().hasOnly(['name', 'email', 'role', 'active', 'departmentId', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'email', 'role'])
        && (d.name is string && d.name.size() <= 200 && d.name.size() > 0)
        && (d.email is string && d.email.size() <= 200 && d.email.size() > 0 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$'))
        && (d.role is string && d.role.size() <= 200 && d.role.size() > 0 && d.role in ['admin', 'dept_head', 'profesor', 'lab_assistant', 'student', 'alumni'])
        && (!('active' in d) || (d.active is bool))
        && (!('departmentId' in d) || d.departmentId == '' || (d.departmentId is string && d.departmentId.size() <= 200));
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if (pendingSelf(uid, request.resource.data) || admin()) && valid_users(request.resource.data)
        && request.resource.data.active is bool && request.resource.data.updatedAt == request.time;
      allow update: if admin() && valid_users(request.resource.data)
        && request.resource.data.active is bool && request.resource.data.updatedAt == request.time
        && (uid != request.auth.uid || (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if false;
    }
    match /students/{id} {
      allow read: if admin() || inDepartment(resource.data);
      allow create: if (admin()) && valid_students(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_students(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_students(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_students(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /employees/{id} {
      allow read: if admin() || inDepartment(resource.data);
      allow create: if (admin()) && valid_employees(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_employees(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_employees(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_employees(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /courses/{id} {
      allow read: if active();
      allow create: if (admin()) && valid_courses(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_courses(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_courses(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_courses(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /calendarEvents/{id} {
      allow read: if active();
      allow create: if (admin() || (role('profesor') && assignedCourse(request.resource.data))) && valid_calendarEvents(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_calendarEvents(request.resource.data) && restored(request.resource.data);
      allow update: if (admin() || (instructor(resource.data) && assignedCourse(request.resource.data))) && valid_calendarEvents(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_calendarEvents(request.resource.data) && updated(request.resource.data);
      allow delete: if admin() || instructor(resource.data);
    }
    match /exams/{id} {
      allow read: if active() && profile().role in ['admin', 'dept_head', 'profesor', 'student'];
      allow create: if (admin() || (role('profesor') && assignedCourse(request.resource.data))) && valid_exams(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_exams(request.resource.data) && restored(request.resource.data);
      allow update: if (admin() || (instructor(resource.data) && assignedCourse(request.resource.data))) && valid_exams(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_exams(request.resource.data) && updated(request.resource.data);
      allow delete: if admin() || instructor(resource.data);
    }
    match /grades/{id} {
      allow read: if admin() || instructor(resource.data) || (role('student') && own(resource.data));
      allow create: if (admin() || (role('profesor') && assignedCourse(request.resource.data) && enrolledStudent(request.resource.data))) && valid_grades(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_grades(request.resource.data) && restored(request.resource.data);
      allow update: if (admin() || (instructor(resource.data) && assignedCourse(request.resource.data) && enrolledStudent(request.resource.data))) && valid_grades(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_grades(request.resource.data) && updated(request.resource.data);
      allow delete: if admin() || instructor(resource.data);
    }
    match /projects/{id} {
      allow read: if staff();
      allow create: if (admin() || role('dept_head')) && valid_projects(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_projects(request.resource.data) && restored(request.resource.data);
      allow update: if (admin() || role('dept_head')) && valid_projects(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_projects(request.resource.data) && updated(request.resource.data);
      allow delete: if admin() || role('dept_head');
    }
    match /research/{id} {
      allow read: if admin() || (staff() && own(resource.data));
      allow create: if (admin() || (staff() && own(request.resource.data))) && valid_research(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_research(request.resource.data) && restored(request.resource.data);
      allow update: if (admin() || (staff() && own(resource.data) && own(request.resource.data))) && valid_research(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_research(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /labs/{id} {
      allow read: if admin() || role('lab_assistant') || role('student');
      allow create: if (admin() || role('lab_assistant')) && valid_labs(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_labs(request.resource.data) && restored(request.resource.data);
      allow update: if (admin() || role('lab_assistant')) && valid_labs(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_labs(request.resource.data) && updated(request.resource.data);
      allow delete: if admin() || role('lab_assistant');
    }
    match /documents/{id} {
      allow read: if active();
      allow create: if (admin()) && valid_documents(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_documents(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_documents(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_documents(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /alumniEvents/{id} {
      allow read: if admin() || role('alumni');
      allow create: if (admin()) && valid_alumniEvents(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_alumniEvents(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_alumniEvents(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_alumniEvents(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /requests/{id} {
      allow read: if admin() || (active() && profile().role in ['student', 'alumni'] && own(resource.data));
      allow create: if (admin() || (active() && profile().role in ['student', 'alumni'] && own(request.resource.data) && request.resource.data.status == 'Na čekanju' && request.resource.data.response == '')) && valid_requests(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_requests(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_requests(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_requests(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /finances/{id} {
      allow read: if admin() || (role('student') && own(resource.data));
      allow create: if (admin()) && valid_finances(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_finances(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_finances(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_finances(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /employeeSchedules/{id} {
      allow read: if admin() || (staff() && own(resource.data));
      allow create: if (admin()) && valid_employeeSchedules(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_employeeSchedules(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_employeeSchedules(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_employeeSchedules(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /workEntries/{id} {
      allow read: if admin() || (staff() && own(resource.data));
      allow create: if (admin() || (staff() && own(request.resource.data))) && valid_workEntries(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_workEntries(request.resource.data) && restored(request.resource.data);
      allow update: if (admin() || (staff() && own(resource.data) && own(request.resource.data))) && valid_workEntries(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_workEntries(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /vacations/{id} {
      allow read: if admin() || (staff() && own(resource.data));
      allow create: if (admin() || (staff() && own(request.resource.data) && request.resource.data.status == 'Na čekanju')) && valid_vacations(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_vacations(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_vacations(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_vacations(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /evaluations/{id} {
      allow read: if admin() || own(resource.data);
      allow create: if (own(request.resource.data)) && valid_evaluations(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_evaluations(request.resource.data) && restored(request.resource.data);
      allow update: if (false) && valid_evaluations(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_evaluations(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }
    match /notifications/{id} {
      allow read: if admin() || own(resource.data);
      allow create: if (admin()) && valid_notifications(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_notifications(request.resource.data) && restored(request.resource.data);
      allow update: if (admin()) && valid_notifications(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_notifications(request.resource.data) && updated(request.resource.data);
      allow delete: if admin();
    }

    match /enrollments/{id} {
      allow read: if admin() || instructor(resource.data) || (role('student') && own(resource.data));
      allow create: if admin() && id.matches('^template-.+$') && valid_enrollments(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_enrollments(request.resource.data) && restored(request.resource.data);
      allow update: if admin() && valid_enrollments(request.resource.data) && updated(request.resource.data);
      allow create: if role('student') && own(request.resource.data) && valid_enrollments(request.resource.data)
        && created(request.resource.data) && request.resource.data.status == 'Na čekanju'
        && id == request.resource.data.courseId + '__' + request.auth.uid
        && request.resource.data.instructorUid == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.instructorUid
        && request.resource.data.courseTitle == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.title;
      allow update: if (admin() || instructor(resource.data)) && valid_enrollments(request.resource.data) && decision(request.resource.data);
      allow delete: if admin();
    }
    match /examBookings/{id} {
      allow read: if admin() || instructor(resource.data) || (role('student') && own(resource.data));
      allow create: if admin() && id.matches('^template-.+$') && valid_examBookings(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_examBookings(request.resource.data) && restored(request.resource.data);
      allow update: if admin() && valid_examBookings(request.resource.data) && updated(request.resource.data);
      allow create: if role('student') && own(request.resource.data) && valid_examBookings(request.resource.data)
        && created(request.resource.data) && request.resource.data.status == 'Na čekanju'
        && id == request.resource.data.examId + '__' + request.auth.uid
        && request.resource.data.instructorUid == get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.instructorUid
        && request.resource.data.courseId == get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.courseId
        && request.resource.data.title == get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.title
        && request.resource.data.date == get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.date;
      allow update: if (admin() || instructor(resource.data)) && valid_examBookings(request.resource.data) && decision(request.resource.data);
      allow delete: if admin();
    }
    match /labBookings/{id} {
      allow read: if admin() || role('lab_assistant') || (role('student') && own(resource.data));
      allow create: if admin() && id.matches('^template-.+$') && valid_labBookings(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_labBookings(request.resource.data) && restored(request.resource.data);
      allow update: if admin() && valid_labBookings(request.resource.data) && updated(request.resource.data);
      allow create: if role('student') && own(request.resource.data) && valid_labBookings(request.resource.data)
        && created(request.resource.data) && request.resource.data.status == 'Na čekanju'
        && id == request.resource.data.labId + '__' + request.auth.uid
        && get(/databases/$(database)/documents/labs/$(request.resource.data.labId)).data.status == 'Dostupno'
        && request.resource.data.title == get(/databases/$(database)/documents/labs/$(request.resource.data.labId)).data.title;
      allow update: if (admin() || role('lab_assistant')) && valid_labBookings(request.resource.data) && decision(request.resource.data);
      allow delete: if admin();
    }
    // Includes all unknown collections, Storage and integrations are not implicitly allowed.
    match /{document=**} { allow read, write: if false; }
  }
}
