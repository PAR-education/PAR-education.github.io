rules_version = '2';
// Generated from src/modules/catalog.js and scripts/generate-rules.mjs.
// Publish to the par-education Firestore database before using real records.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() {
      let p = profile();
      return signedIn() && p.active == true
        && p.role in ['admin', 'administracija_par', 'dept_head', 'profesor', 'lab_assistant', 'student', 'alumni']
        && (!p.get('emailVerificationRequired', false) || request.auth.token.get('email_verified', false));
    }
    function role(r) { return active() && profile().role == r; }
    function admin() { return role('admin'); }
    function staff() { return active() && profile().role in ['admin', 'dept_head', 'profesor', 'lab_assistant']; }
    function own(d) { return active() && d.ownerUid == request.auth.uid; }
    function assignedUid(d) { return (('instructorUid' in d) && d.instructorUid == request.auth.uid) || (('instructorUids' in d) && request.auth.uid in d.instructorUids); }
    function instructor(d) { return role('profesor') && assignedUid(d); }
    function inDepartment(d) {
      return role('dept_head') && profile().departmentId is string
        && profile().departmentId.size() > 0 && d.departmentId == profile().departmentId;
    }
    function created(d) {
      return d.createdAt == request.time && d.updatedAt == request.time && d.createdBy == request.auth.uid;
    }
    function restored(d) {
      return d.createdAt is timestamp && d.createdBy is string
        && d.createdBy.size() > 0 && d.createdBy.size() <= 1500
        && d.updatedAt == request.time;
    }
    function pendingSelf(uid, d) {
      return signedIn() && uid == request.auth.uid
        && d.role == 'student' && d.active == false && d.departmentId == ''
        && d.email == request.auth.token.email && d.emailVerificationRequired == true
        && d.emailVerified == request.auth.token.get('email_verified', false) && created(d);
    }
    function updated(d) {
      return d.updatedAt == request.time && d.createdAt == resource.data.createdAt
        && d.createdBy == resource.data.createdBy;
    }
    function assignedCourse(d) {
      let c = get(/databases/$(database)/documents/courses/$(d.courseId)).data;
      return assignedUid(c) && d.instructorUid == c.instructorUid
        && (!('instructorUids' in d) || d.instructorUids == c.get('instructorUids', [c.instructorUid]));
    }
    function enrollmentKey(d, uid) { return d.courseId + '__' + uid + (d.get('academicYear','') == '' ? '' : '__' + d.academicYear.split('/')[0]); }
    function enrolledStudent(d) {
      let enrollment = get(/databases/$(database)/documents/enrollments/$(enrollmentKey(d, d.ownerUid))).data;
      return enrollment.ownerUid == d.ownerUid && enrollment.courseId == d.courseId && enrollment.status == 'Odobreno';
    }
    function broadcastVisible(d) {
      return active() && ((role('administracija_par') && d.get('audience','') in ['student','profesor','students_professors'])
        || (profile().role in ['student','profesor'] && d.get('audience','') in [profile().role,'students_professors']));
    }
    function officeBroadcast(d) {
      return role('administracija_par') && d.get('ownerUid','') == ''
        && d.get('audience','') in ['student','profesor','students_professors']
        && d.get('sourceModule','') == '' && d.get('sourceId','') == '';
    }
    function courseNoticeAuthor(d) {
      return role('profesor') && d.get('sourceModule','') == 'courses' && d.createdBy == request.auth.uid;
    }
    function manualCourseNotice(d) {
      let c = get(/databases/$(database)/documents/courses/$(d.courseId)).data;
      let en = get(/databases/$(database)/documents/enrollments/$(d.enrollmentId)).data;
      return role('profesor') && assignedUid(c) && d.get('audience','') == ''
        && d.sourceModule == 'courses' && d.sourceId == d.courseId && d.courseTitle == c.title
        && en.status == 'Odobreno' && en.courseId == d.courseId && en.ownerUid == d.ownerUid && d.ownerUid != ''
        && d.get('academicYear','') == en.get('academicYear','')
        && (c.get('academicYear','') == '' || d.get('academicYear','') == c.academicYear);
    }
    function teacherNotice(d) {
      let source = get(/databases/$(database)/documents/$(d.sourceModule)/$(d.sourceId)).data;
      return role('profesor') && d.sourceModule in ['calendarEvents','enrollments','examBookings'] && instructor(source)
        && ((d.sourceModule in ['enrollments','examBookings'] && source.ownerUid == d.ownerUid)
          || (d.sourceModule == 'calendarEvents' && enrolledStudent({'courseId':source.courseId,'ownerUid':d.ownerUid,'academicYear':source.get('academicYear','')})));
    }
    function studentEnrollment(d, id) {
      let c = get(/databases/$(database)/documents/courses/$(d.courseId)).data;
      return role('student') && d.ownerUid == request.auth.uid && d.status == 'Na čekanju'
        && id == enrollmentKey(d, request.auth.uid) && d.instructorUid == c.instructorUid
        && d.get('instructorUids', [d.instructorUid]) == c.get('instructorUids', [c.instructorUid])
        && d.get('academicYear','') == c.get('academicYear','') && d.courseTitle == c.title;
    }
    function decision(d) {
      return resource.data.status == 'Na čekanju' && d.status in ['Odobreno', 'Odbijeno']
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) && updated(d);
    }
    function valid_attendance(d) {
      return d.keys().hasOnly(['eventId', 'enrollmentId', 'studentId', 'ownerUid', 'studentName', 'markedByUid', 'markedByRole', 'courseId', 'courseTitle', 'date', 'academicYear', 'instructorUid', 'instructorUids', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['eventId', 'enrollmentId', 'studentName', 'courseId', 'courseTitle', 'date', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.eventId is string && d.eventId.size() <= 200 && d.eventId.size() > 0)
        && (d.enrollmentId is string && d.enrollmentId.size() <= 200 && d.enrollmentId.size() > 0)
        && (!('studentId' in d) || d.studentId == '' || (d.studentId is string && d.studentId.size() <= 200))
        && (!('ownerUid' in d) || d.ownerUid == '' || (d.ownerUid is string && d.ownerUid.size() <= 200))
        && (d.studentName is string && d.studentName.size() <= 200 && d.studentName.size() > 0)
        && (!('markedByUid' in d) || d.markedByUid == '' || (d.markedByUid is string && d.markedByUid.size() <= 200))
        && (!('markedByRole' in d) || d.markedByRole == '' || (d.markedByRole is string && d.markedByRole.size() <= 200 && d.markedByRole in ['admin', 'administracija_par', 'profesor', 'student']))
        && (d.courseId is string && d.courseId.size() <= 200 && d.courseId.size() > 0)
        && (d.courseTitle is string && d.courseTitle.size() <= 200 && d.courseTitle.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('academicYear' in d) || d.academicYear == '' || (d.academicYear is string && d.academicYear.size() <= 200 && d.academicYear.matches('^[0-9]{4}/[0-9]{4}$')))
        && (!('instructorUid' in d) || d.instructorUid == '' || (d.instructorUid is string && d.instructorUid.size() <= 200))
        && (!('instructorUids' in d) || (d.instructorUids is list && d.instructorUids.size() <= 10))
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Prisutan', 'Odsutan', 'Opravdano odsutan', 'Nije evidentirano']);
    }
    function valid_rooms(d) {
      return d.keys().hasOnly(['name', 'aliases', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.name is string && d.name.size() <= 200 && d.name.size() > 0)
        && (!('aliases' in d) || d.aliases == '' || (d.aliases is string && d.aliases.size() <= 2000));
    }
    function valid_students(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'jmbag', 'study', 'group', 'email', 'departmentId', 'year', 'status', 'homeUniversity', 'country', 'exchangeSemester', 'gpa', 'ects', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'departmentId', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (!('ownerUid' in d) || d.ownerUid == '' || (d.ownerUid is string && d.ownerUid.size() <= 200))
        && (d.name is string && d.name.size() <= 200 && d.name.size() > 0)
        && (!('jmbag' in d) || d.jmbag == '' || (d.jmbag is string && d.jmbag.size() <= 200))
        && (!('study' in d) || d.study == '' || (d.study is string && d.study.size() <= 200))
        && (!('group' in d) || d.group == '' || (d.group is string && d.group.size() <= 200))
        && (!('email' in d) || d.email == '' || (d.email is string && d.email.size() <= 200 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')))
        && (d.departmentId is string && d.departmentId.size() <= 200 && d.departmentId.size() > 0)
        && (!('year' in d) || (d.year is int && d.year >= 1 && d.year <= 6))
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Redovni', 'Izvanredni', 'Alumni', 'Erasmus'])
        && (!('homeUniversity' in d) || d.homeUniversity == '' || (d.homeUniversity is string && d.homeUniversity.size() <= 200))
        && (!('country' in d) || d.country == '' || (d.country is string && d.country.size() <= 200))
        && (!('exchangeSemester' in d) || d.exchangeSemester == '' || (d.exchangeSemester is string && d.exchangeSemester.size() <= 200))
        && (!('gpa' in d) || (d.gpa is number && d.gpa >= 1 && d.gpa <= 5))
        && (!('ects' in d) || (d.ects is number && d.ects >= 0 && d.ects <= 360));
    }
    function valid_employees(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'position', 'departmentName', 'departmentId', 'email', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'position', 'departmentId', 'email', 'createdAt', 'createdBy', 'updatedAt'])
        && (!('ownerUid' in d) || d.ownerUid == '' || (d.ownerUid is string && d.ownerUid.size() <= 200))
        && (d.name is string && d.name.size() <= 200 && d.name.size() > 0)
        && (d.position is string && d.position.size() <= 200 && d.position.size() > 0)
        && (!('departmentName' in d) || d.departmentName == '' || (d.departmentName is string && d.departmentName.size() <= 200))
        && (d.departmentId is string && d.departmentId.size() <= 200 && d.departmentId.size() > 0)
        && (d.email is string && d.email.size() <= 200 && d.email.size() > 0 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$'));
    }
    function valid_courses(d) {
      return d.keys().hasOnly(['title', 'academicYear', 'courseType', 'ects', 'semester', 'instructorUid', 'instructorUids', 'instructorName', 'room', 'day', 'startTime', 'endTime', 'description', 'outcomes', 'literature', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'semester', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (!('academicYear' in d) || d.academicYear == '' || (d.academicYear is string && d.academicYear.size() <= 200 && d.academicYear.matches('^[0-9]{4}/[0-9]{4}$')))
        && (!('courseType' in d) || d.courseType == '' || (d.courseType is string && d.courseType.size() <= 200))
        && (!('ects' in d) || (d.ects is number && d.ects >= 1 && d.ects <= 30))
        && (d.semester is string && d.semester.size() <= 200 && d.semester.size() > 0 && d.semester in ['Zimski', 'Ljetni'])
        && (!('instructorUid' in d) || d.instructorUid == '' || (d.instructorUid is string && d.instructorUid.size() <= 200))
        && (!('instructorUids' in d) || (d.instructorUids is list && d.instructorUids.size() <= 10))
        && (!('instructorName' in d) || d.instructorName == '' || (d.instructorName is string && d.instructorName.size() <= 200))
        && (!('room' in d) || d.room == '' || (d.room is string && d.room.size() <= 200))
        && (!('day' in d) || d.day == '' || (d.day is string && d.day.size() <= 200 && d.day in ['Pon', 'Uto', 'Sri', 'Čet', 'Pet']))
        && (!('startTime' in d) || (d.startTime is string && d.startTime.size() <= 200 && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('endTime' in d) || (d.endTime is string && d.endTime.size() <= 200 && d.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('description' in d) || d.description == '' || (d.description is string && d.description.size() <= 20000))
        && (!('outcomes' in d) || d.outcomes == '' || (d.outcomes is string && d.outcomes.size() <= 20000))
        && (!('literature' in d) || d.literature == '' || (d.literature is string && d.literature.size() <= 20000))
        && (!('startTime' in d) || !('endTime' in d) || d.endTime > d.startTime);
    }
    function valid_exams(d) {
      return d.keys().hasOnly(['courseId', 'academicYear', 'instructorUid', 'instructorUids', 'instructorName', 'title', 'date', 'time', 'room', 'capacity', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['courseId', 'instructorUid', 'title', 'date', 'time', 'room', 'capacity', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.courseId is string && d.courseId.size() <= 200 && d.courseId.size() > 0)
        && (!('academicYear' in d) || d.academicYear == '' || (d.academicYear is string && d.academicYear.size() <= 200 && d.academicYear.matches('^[0-9]{4}/[0-9]{4}$')))
        && (d.instructorUid is string && d.instructorUid.size() <= 200 && d.instructorUid.size() > 0)
        && (!('instructorUids' in d) || (d.instructorUids is list && d.instructorUids.size() <= 10))
        && (!('instructorName' in d) || d.instructorName == '' || (d.instructorName is string && d.instructorName.size() <= 200))
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.time is string && d.time.size() <= 200 && d.time.size() > 0 && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (d.room is string && d.room.size() <= 200 && d.room.size() > 0)
        && (d.capacity is int && d.capacity >= 1 && d.capacity <= 1000);
    }
    function valid_grades(d) {
      return d.keys().hasOnly(['ownerUid', 'studentName', 'courseId', 'academicYear', 'courseTitle', 'instructorUid', 'instructorUids', 'grade', 'date', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'studentName', 'courseId', 'courseTitle', 'instructorUid', 'grade', 'date', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.studentName is string && d.studentName.size() <= 200 && d.studentName.size() > 0)
        && (d.courseId is string && d.courseId.size() <= 200 && d.courseId.size() > 0)
        && (!('academicYear' in d) || d.academicYear == '' || (d.academicYear is string && d.academicYear.size() <= 200 && d.academicYear.matches('^[0-9]{4}/[0-9]{4}$')))
        && (d.courseTitle is string && d.courseTitle.size() <= 200 && d.courseTitle.size() > 0)
        && (d.instructorUid is string && d.instructorUid.size() <= 200 && d.instructorUid.size() > 0)
        && (!('instructorUids' in d) || (d.instructorUids is list && d.instructorUids.size() <= 10))
        && (d.grade is int && d.grade >= 1 && d.grade <= 5)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function valid_enrollments(d) {
      return d.keys().hasOnly(['ownerUid', 'studentId', 'academicYear', 'semester', 'ownerName', 'courseId', 'courseTitle', 'instructorUid', 'instructorUids', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerName', 'courseId', 'courseTitle', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (!('ownerUid' in d) || d.ownerUid == '' || (d.ownerUid is string && d.ownerUid.size() <= 200))
        && (!('studentId' in d) || d.studentId == '' || (d.studentId is string && d.studentId.size() <= 200))
        && (!('academicYear' in d) || d.academicYear == '' || (d.academicYear is string && d.academicYear.size() <= 200 && d.academicYear.matches('^[0-9]{4}/[0-9]{4}$')))
        && (!('semester' in d) || d.semester == '' || (d.semester is string && d.semester.size() <= 200 && d.semester in ['Zimski', 'Ljetni']))
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.courseId is string && d.courseId.size() <= 200 && d.courseId.size() > 0)
        && (d.courseTitle is string && d.courseTitle.size() <= 200 && d.courseTitle.size() > 0)
        && (!('instructorUid' in d) || d.instructorUid == '' || (d.instructorUid is string && d.instructorUid.size() <= 200))
        && (!('instructorUids' in d) || (d.instructorUids is list && d.instructorUids.size() <= 10))
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Na čekanju', 'Odobreno', 'Odbijeno'])
        && (('ownerUid' in d && d.ownerUid.size() > 0) || ('studentId' in d && d.studentId.size() > 0));
    }
    function valid_examBookings(d) {
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'examId', 'courseId', 'academicYear', 'instructorUid', 'instructorUids', 'title', 'date', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'ownerName', 'examId', 'courseId', 'instructorUid', 'title', 'date', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.examId is string && d.examId.size() <= 200 && d.examId.size() > 0)
        && (d.courseId is string && d.courseId.size() <= 200 && d.courseId.size() > 0)
        && (!('academicYear' in d) || d.academicYear == '' || (d.academicYear is string && d.academicYear.size() <= 200 && d.academicYear.matches('^[0-9]{4}/[0-9]{4}$')))
        && (d.instructorUid is string && d.instructorUid.size() <= 200 && d.instructorUid.size() > 0)
        && (!('instructorUids' in d) || (d.instructorUids is list && d.instructorUids.size() <= 10))
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.status is string && d.status.size() <= 200 && d.status.size() > 0 && d.status in ['Na čekanju', 'Odobreno', 'Odbijeno']);
    }
    function valid_calendarEvents(d) {
      return d.keys().hasOnly(['title', 'courseId', 'instructorUid', 'instructorUids', 'study', 'group', 'academicYear', 'semester', 'teachingType', 'seriesId', 'date', 'time', 'endTime', 'room', 'day', 'instructorName', 'online', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'date', 'time', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (!('courseId' in d) || d.courseId == '' || (d.courseId is string && d.courseId.size() <= 200))
        && (!('instructorUid' in d) || d.instructorUid == '' || (d.instructorUid is string && d.instructorUid.size() <= 200))
        && (!('instructorUids' in d) || (d.instructorUids is list && d.instructorUids.size() <= 10))
        && (!('study' in d) || d.study == '' || (d.study is string && d.study.size() <= 200))
        && (!('group' in d) || d.group == '' || (d.group is string && d.group.size() <= 200))
        && (!('academicYear' in d) || d.academicYear == '' || (d.academicYear is string && d.academicYear.size() <= 200 && d.academicYear.matches('^[0-9]{4}/[0-9]{4}$')))
        && (!('semester' in d) || d.semester == '' || (d.semester is string && d.semester.size() <= 200 && d.semester in ['Zimski', 'Ljetni']))
        && (!('teachingType' in d) || d.teachingType == '' || (d.teachingType is string && d.teachingType.size() <= 200))
        && (!('seriesId' in d) || d.seriesId == '' || (d.seriesId is string && d.seriesId.size() <= 200))
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.time is string && d.time.size() <= 200 && d.time.size() > 0 && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (!('endTime' in d) || (d.endTime is string && d.endTime.size() <= 200 && d.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('room' in d) || d.room == '' || (d.room is string && d.room.size() <= 200))
        && (!('day' in d) || d.day == '' || (d.day is string && d.day.size() <= 200))
        && (!('instructorName' in d) || d.instructorName == '' || (d.instructorName is string && d.instructorName.size() <= 200))
        && (!('online' in d) || (d.online is bool))
        && (!('description' in d) || d.description == '' || (d.description is string && d.description.size() <= 2000))
        && (!('endTime' in d) || d.endTime > d.time);
    }
    function valid_projects(d) {
      return d.keys().hasOnly(['title', 'fundingLine', 'duration', 'budget', 'startDate', 'endDate', 'partners', 'workPackages', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'fundingLine', 'budget', 'startDate', 'endDate', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.title is string && d.title.size() <= 200 && d.title.size() > 0)
        && (d.fundingLine is string && d.fundingLine.size() <= 200 && d.fundingLine.size() > 0)
        && (!('duration' in d) || d.duration == '' || (d.duration is string && d.duration.size() <= 200))
        && (d.budget is number && d.budget >= 0 && d.budget <= 1000000000)
        && (d.startDate is string && d.startDate.size() <= 200 && d.startDate.size() > 0 && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.endDate is string && d.endDate.size() <= 200 && d.endDate.size() > 0 && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('partners' in d) || d.partners == '' || (d.partners is string && d.partners.size() <= 2000))
        && (!('workPackages' in d) || d.workPackages == '' || (d.workPackages is string && d.workPackages.size() <= 2000))
