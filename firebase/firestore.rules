        && (d.activity is string && d.activity.size() <= 200 && d.activity.size() > 0 && d.activity in ['Ured', 'Nastava', 'Godišnji odmor', 'Bolovanje', 'Putni nalog', 'Slobodan dan'])
        && (d.startTime is string && d.startTime.size() <= 200 && d.startTime.size() > 0 && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (d.endTime is string && d.endTime.size() <= 200 && d.endTime.size() > 0 && d.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (d.departmentId is string && d.departmentId.size() <= 200 && d.departmentId.size() > 0)
