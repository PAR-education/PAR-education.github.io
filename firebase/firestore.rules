    function valid_workEntries(d) {
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'date', 'category', 'hours', 'projectId', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'ownerName', 'date', 'category', 'hours', 'description', 'createdAt', 'createdBy', 'updatedAt'])
        && (d.ownerUid is string && d.ownerUid.size() <= 200 && d.ownerUid.size() > 0)
        && (d.ownerName is string && d.ownerName.size() <= 200 && d.ownerName.size() > 0)
        && (d.date is string && d.date.size() <= 200 && d.date.size() > 0 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.category is string && d.category.size() <= 200 && d.category.size() > 0 && d.category in ['Administracija', 'Nastava', 'Rad na projektu', 'Znanstveni rad', 'Izvanredne aktivnosti'])
