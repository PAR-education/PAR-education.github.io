      allow create: if (admin() || role('administracija_par') || (role('profesor') && assignedCourse(request.resource.data))) && valid_calendarEvents(request.resource.data) && created(request.resource.data);
      allow create: if admin() && valid_calendarEvents(request.resource.data) && restored(request.resource.data);
      allow update: if (admin() || role('administracija_par') || (instructor(resource.data) && assignedCourse(request.resource.data))) && valid_calendarEvents(request.resource.data) && updated(request.resource.data);
      allow update: if admin() && valid_calendarEvents(request.resource.data) && updated(request.resource.data);
      allow delete: if admin() || instructor(resource.data);
