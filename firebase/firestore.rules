    match /exams/{id} {
      allow read: if active() && profile().role in ['admin', 'dept_head', 'profesor', 'student'];
      
      allow create: if (admin() || (role('profesor') && assignedCourse(request.resource.data))) && valid_exams(request.resource.data) && created(request.resource.data);
